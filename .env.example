# =============================================================================
# BeeKL — Environment Variables
# Copy this file to `.env` and fill in the values.
# NEVER commit your real `.env` file. NEVER expose server secrets to the browser.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the client.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# App URL (used for auth callbacks, canonical URLs, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ----------------------------------------------------
# Server-side ONLY. Never expose this.
DATABASE_URL=postgresql://user:password@localhost:5432/beekl?schema=public

# --- Authentication (NextAuth) ------------------------------------------------
# Server-side ONLY. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# --- Shopify Storefront API (public storefront data) --------------------------
# The store domain can be public. The Storefront token is a public token but
# should still be treated with care.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# --- Shopify Admin API (privileged, SERVER-SIDE ONLY) -------------------------
# NEVER expose this token to the browser.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2024-07

# Optional: verify incoming Shopify webhooks
SHOPIFY_WEBHOOK_SECRET=

# --- Print-on-Demand (POD) provider (SERVER-SIDE ONLY) ------------------------
# Leave blank if not connected. The app will show "POD provider not connected."
POD_PROVIDER=
POD_API_KEY=
POD_API_URL=

# --- Media / Uploads (optional) ----------------------------------------------
CLOUDINARY_URL=
